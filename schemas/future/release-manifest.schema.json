{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregorycwhill/charitygraph-data/blob/main/schemas/future/release-manifest.schema.json",
  "title": "CharityGraph future release manifest proposal",
  "type": "object",
  "required": ["release_id", "dataset_version", "contract_version", "based_on_release", "generated_at", "publication_identity", "entity_count", "source_record_count", "validation", "artefacts"],
  "additionalProperties": false,
  "properties": {
    "release_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1, "not": {"const": "0.5"}},
    "based_on_release": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "publication_identity": {
      "type": "object",
      "required": ["publisher_name", "canonical_data_repository", "immutable_release_path", "data_license_identifier", "license_url", "attribution_guidance", "upstream_rights_caveat_url", "editorial_commitments", "producing_builder"],
      "additionalProperties": false,
      "properties": {
        "publisher_name": {"const": "CharityGraph"},
        "canonical_data_repository": {"const": "https://github.com/gregorycwhill/charitygraph-data"},
        "immutable_release_path": {"type": "string", "pattern": "^releases/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "data_license_identifier": {"const": "CC-BY-4.0"},
        "license_url": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"},
        "attribution_guidance": {"type": "string", "minLength": 1},
        "upstream_rights_caveat_url": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"},
        "editorial_commitments": {
          "type": "object",
          "required": ["identifier", "version", "url"],
          "additionalProperties": false,
          "properties": {
            "identifier": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"}
          }
        },
        "producing_builder": {
          "type": "object",
          "required": ["version"],
          "additionalProperties": false,
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$"}
          }
        }
      }
    },
    "entity_count": {"type": "integer", "minimum": 0},
    "source_record_count": {"type": "integer", "minimum": 0},
    "validation": {"type": "object", "required": ["status"], "additionalProperties": false, "properties": {"status": {"const": "passed"}}},
    "artefacts": {"type": "object", "additionalProperties": {"type": "object", "required": ["sha256", "bytes"], "additionalProperties": false, "properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}}
  }
}
