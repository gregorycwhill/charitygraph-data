{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://charitygraph.example/schema/semantic-demand-scenario-v0.2.json",
  "title":"SemanticDemandScenario",
  "type":"object","additionalProperties":false,
  "required":["id","scenario_type","persona","analytical_lenses","job_to_be_done","surface_question","semantic_contract","primary_domains","supporting_domains","answerability","adversarial","semantic_signature","distinctiveness_rationale"],
  "properties":{
    "id":{"type":"string","pattern":"^SDC-[0-9]{4,}$"},
    "scenario_type":{"enum":["question","correction_challenge"]},
    "persona":{"enum":["public_donor_participant","charity_insider_adviser","analyst","consultant_service_system_planner","funder_diligence","researcher_evaluator","downstream_agent","data_developer"]},
    "analytical_lenses":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["discovery","cohorting","service_system_mapping","funding_ecosystem","fundraising","finance","evidence_evaluation","ethos_conduct","mandate_screening","reproducibility","coverage"]}},
    "tier":{"enum":["A","B","C"]},
    "job_to_be_done":{"type":"string","minLength":10},"surface_question":{"type":"string","minLength":10},
    "semantic_contract":{"type":"object","additionalProperties":false,"required":["parameter_slots","required_subject_scope_types","required_proposition_families","analytical_operations","required_joins","temporal_compatibility","freshness","evidence_standard","expected_output_shape","forbidden_non_inferences"],"properties":{"parameter_slots":{"type":"object","additionalProperties":{"type":"string"}},"required_subject_scope_types":{"type":"array","minItems":1,"items":{"type":"string"}},"required_proposition_families":{"type":"array","minItems":1,"items":{"type":"string"}},"analytical_operations":{"type":"array","minItems":1,"items":{"type":"string"}},"required_joins":{"type":"array","items":{"type":"string"}},"temporal_compatibility":{"type":"string"},"freshness":{"type":"string"},"evidence_standard":{"type":"string"},"expected_output_shape":{"type":"string"},"forbidden_non_inferences":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "primary_domains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":20}},"supporting_domains":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":20}},
    "answerability":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["supported","bounded_partial","tested_missingness","unresolved","insufficient","rejected","held_for_governance"]}},
    "adversarial":{"type":"boolean"},"semantic_signature":{"type":"string","minLength":10},"distinctiveness_rationale":{"type":"string","minLength":10},
    "correction":{"type":"object","additionalProperties":false,"required":["challenge_statement","challenge_actor_affiliation","challenged_target","proposed_replacement_or_qualification","challenge_basis","correction_class","correction_loci","governance_disposition","lineage_effects","invalidation_reprojection","revised_answerability","forbidden_behaviours"],"properties":{"challenge_statement":{"type":"string"},"challenge_actor_affiliation":{"type":"string"},"challenged_target":{"type":"object","required":["subject","scope","predicate"],"additionalProperties":{"type":"string"}},"proposed_replacement_or_qualification":{"type":"string"},"challenge_basis":{"type":"string"},"correction_class":{"enum":["amended_evidence","source_version_change","extraction_representation_error","semantic_mapping_error","identity_binding_error","scope_binding_error","temporal_currentness_error","classification_error","coverage_acquisition_error","unsupported_inference","governance_adjudication","projection_rendering_error"]},"correction_loci":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["source_acquisition","source_version","representation","evidence_extraction","identity_binding","scope_binding","semantic_mapping","classification","governance_adjudication","canonical_observation","coverage","projection"]}},"governance_disposition":{"enum":["accept_governed_replacement","accept_qualification","hold_for_evidence","reject_insufficient","reject_unsupported","escalate_systemic_remediation"]},"lineage_effects":{"type":"array","minItems":1,"items":{"type":"string"}},"invalidation_reprojection":{"type":"array","minItems":1,"items":{"type":"string"}},"revised_answerability":{"enum":["supported","bounded_partial","tested_missingness","unresolved","insufficient","rejected","held_for_governance"]},"forbidden_behaviours":{"type":"array","minItems":1,"items":{"type":"string"}}}}
  },
  "allOf":[{"if":{"properties":{"scenario_type":{"const":"correction_challenge"}}},"then":{"required":["correction"]}},{"if":{"properties":{"scenario_type":{"const":"question"}}},"then":{"not":{"required":["correction"]}}}]
}
